---
import { site } from '../lib/site.ts';
import { url } from '../lib/paths.ts';
import Themed from './Themed.astro';

interface Props {
  /**
   * True only where the person is the subject of the page, which is the home
   * page. Everywhere else the name is a repeated site header, and marking it
   * as a heading gives every page two <h1>s.
   */
  primary?: boolean;
}
const { primary = false } = Astro.props;
---
<div class="identity">
  {/*
    The lab's own name, above the institutional taxonomy underneath it. Themed
    markup rather than a line every design has to find room for: Record sets it
    as a small tracked label over the strapline, Feature as the masthead flag
    the rest of the page hangs off. This is a line inside the identity block,
    not a second identity block.
  */}
  <Themed themes={['a', 'b']}><p class="identity__lab">{site.labName}</p></Themed>
  {primary
    ? <h1 class="identity__name">{site.name}</h1>
    : <p class="identity__name">{site.name}</p>}
  {/*
    A <figure> so the portrait can carry a caption. The caption is hidden by
    default and revealed by whichever design wants every image credited; the
    figure itself is a plain wrapper, so the designs that do not use it render
    exactly as they did before.
  */}
  <figure class="identity__figure">
    <img class="identity__photo" src={url(site.photo)} alt="" width="400" height="400" />
    <figcaption class="identity__credit">
      {site.name}. Photograph credit to be added before launch.
    </figcaption>
  </figure>
  <div class="identity__meta">
    <p>{site.discipline}</p>
    <p>{site.jobTitle}</p>
    <p>{site.department}</p>
    <p>{site.institution}</p>
  </div>
  <div class="social">
    <a href={`https://orcid.org/${site.orcid}`} rel="noopener">ORCID</a>
    {site.github && <a href={`https://github.com/${site.github}`} rel="noopener">GitHub</a>}
    {site.scholar && <a href={`https://scholar.google.com/citations?user=${site.scholar}`} rel="noopener">Scholar</a>}
  </div>
</div>
