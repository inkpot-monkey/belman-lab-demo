---
/**
 * DEMO ONLY - delete before launch.
 *
 * Swaps the design without reloading, so the content stays pinned and only the
 * design moves. The choice persists so a reload does not lose her place.
 *
 * Collapsible, because the panel is the one thing on the screen that is not
 * the site: open it to switch, close it to look. Closed, it names the design
 * showing, which is the only thing it has to say while she is reading. Whether
 * it is open persists too - a phone is where the panel is most in the way and
 * also where reopening it is most annoying.
 */
import { THEMES, DEFAULT_THEME } from '../lib/themes.ts';

const fallback = THEMES.find((theme) => theme.id === DEFAULT_THEME) ?? THEMES[0]!;
---
<aside class="switcher" aria-label="Design preview">
  <details class="switcher__panel" open>
    <summary class="switcher__summary">
      <span class="switcher__legend">Preview design</span>
      {/* One line each: a break before an expression would eat the space. */}
      <span class="switcher__current"><span class="switcher__name">{fallback.name}</span><span class="switcher__short">{fallback.shortName}</span></span>
    </summary>

    <div class="switcher__options" role="radiogroup" aria-label="Preview design">
      {THEMES.map((theme) => (
        <label class="switcher__option">
          <input type="radio" name="theme" value={theme.id} />
          <span class="switcher__text">
            <span class="switcher__name">{theme.name}</span>
            <span class="switcher__short">{theme.shortName}</span>
            <span class="switcher__desc">{theme.description}</span>
          </span>
        </label>
      ))}
    </div>
  </details>
</aside>

<script is:inline define:vars={{ fallback: DEFAULT_THEME }}>
  // The <head> script has already applied the stored theme; this only syncs the
  // control and writes changes back.
  const root = document.documentElement;
  const panel = document.querySelector('.switcher__panel');
  const current = root.dataset.theme || fallback;

  // The name shown while the panel is shut. Copied off the checked radio's own
  // label rather than kept in a second list that could drift from it. Both the
  // long and the short name, because which of the two is showing is a question
  // for the stylesheet and the width of the screen, not for this.
  const target = document.querySelector('.switcher__current');
  const showCurrent = (input) => {
    if (!target) return;
    for (const part of ['.switcher__name', '.switcher__short']) {
      const to = target.querySelector(part);
      const from = input.parentElement.querySelector(`.switcher__text ${part}`);
      if (to && from) to.textContent = from.textContent;
    }
  };

  for (const input of document.querySelectorAll('input[name="theme"]')) {
    input.checked = input.value === current;
    if (input.checked) showCurrent(input);
    input.addEventListener('change', () => {
      root.dataset.theme = input.value;
      showCurrent(input);
      try {
        localStorage.setItem('demo-theme', input.value);
      } catch {
        // Private browsing or blocked site data: the switch still works for
        // this page view, it just will not be remembered.
      }
    });
  }

  if (panel) {
    /*
      Open on a screen with room for it, shut on one without, and whatever she
      last chose beats both. Run inline where the panel is parsed rather than on
      load, so a panel that should be shut is never painted open.
    */
    let stored = null;
    try {
      stored = localStorage.getItem('demo-switcher');
    } catch {
      // Same as above: no memory, but a working control.
    }
    panel.open = stored === null ? matchMedia('(min-width: 34rem)').matches : stored === 'open';

    panel.addEventListener('toggle', () => {
      try {
        localStorage.setItem('demo-switcher', panel.open ? 'open' : 'shut');
      } catch {
        // Ditto.
      }
    });
  }
</script>
