---
import { getCollection } from 'astro:content';
import Tokens from '../components/Tokens.astro';
import Identity from '../components/Identity.astro';
import { site } from '../lib/site.ts';
import { NAV, SHELVED_PAGES, url, isCurrent, type NavItem } from '../lib/nav.ts';
import { isIndexable } from '../lib/env.ts';
import '../styles/fonts.css';
import '../styles/base.css';
// The design's own file, extending the layers base.css declares. Imported
// after it so a same-specificity rule resolves in the design's favour.
import '../styles/design.css';

interface Props {
  title: string;
  description?: string;
  /** Keeps internal-facing pages out of search results. */
  noindex?: boolean;
  /** Marks the page whose subject is the person, so their name is its heading. */
  identityIsHeading?: boolean;
}
const { title, description, noindex, identityIsHeading } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(site.photo), Astro.site);
const fullTitle = `${title} | ${site.name}`;
const summary = description ?? `${site.name}, ${site.jobTitle} at ${site.institution}.`;

const pages = await getCollection('pages');
const pageNav: NavItem[] = pages
  .filter((page) => (page.data.showInNav as boolean) && !SHELVED_PAGES.includes(page.id))
  .map((page) => ({
    label: page.data.title as string,
    href: page.id === 'home' ? '/' : `/${page.id}`,
    order: page.data.order as number,
  }));

const nav = [...pageNav, ...NAV].sort((a, b) => a.order - b.order);
const pathname = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#7b4b8a" />
    {(noindex || !isIndexable) && <meta name="robots" content="noindex" />}

    <!-- Link previews: this URL gets pasted into email and chat. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.labName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <Tokens />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="page">
      <nav class="site-nav nav" aria-label="Primary">
        {nav.map((item) => (
          <a href={url(item.href)} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <aside class="identity-column">
        <Identity primary={identityIsHeading} />
      </aside>

      <main id="main" class="flow prose">
        <slot />
      </main>

      {/*
        A second column beside the content, for a page that wants one: an
        in-page index. Rendered only when a page fills it, so it costs nothing
        on the pages that do not, and placed by `design.css`.
      */}
      {Astro.slots.has('rail') && (
        <aside class="rail"><slot name="rail" /></aside>
      )}
    </div>

    <footer class="footer">
      <div class="footer__inner">
        <p>&copy; {new Date().getFullYear()} {site.labName}</p>
        <p>{site.name}</p>
        <p>{site.email}</p>
        <p>{site.jobTitle} | {site.department}</p>
        {site.office && <p>{site.office}</p>}
        {site.address && <p>{site.address}</p>}
      </div>
    </footer>

  </body>
</html>
