---
import { getCollection } from 'astro:content';
import Tokens from '../components/Tokens.astro';
import Identity from '../components/Identity.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import Themed from '../components/Themed.astro';
import { site } from '../lib/site.ts';
import { revision } from '../lib/build.ts';
import { COLLECTION_NAV, url, isCurrent, type NavItem } from '../lib/nav.ts';
import { DEFAULT_THEME, THEMES } from '../lib/themes.ts';
import { isIndexable } from '../lib/env.ts';
import '../styles/fonts.css';
import '../styles/base.css';
// One file per design, each extending the layers base.css declares. Imported
// after it so a same-specificity rule resolves in the design's favour.
import '../styles/themes/a.css';
import '../styles/themes/b.css';
import '../styles/themes/c.css';
import '../styles/demo.css';

interface Props {
  title: string;
  description?: string;
  /** Keeps internal-facing pages out of search results. */
  noindex?: boolean;
  /** Marks the page whose subject is the person, so their name is its heading. */
  identityIsHeading?: boolean;
  /**
   * Repository path of the one file this page is written in, where there is
   * one. Index pages that assemble a collection have no single source and
   * leave it unset.
   */
  source?: string;
}
const { title, description, noindex, identityIsHeading, source } = Astro.props;

// "Edit this page" needs somewhere to send the editor, so both halves have to
// be present before the affordance is offered.
const editHref = source && site.repo ? `${site.repo}/edit/main/${source}` : undefined;
const revisionHref = revision && site.repo ? `${site.repo}/commit/${revision.hash}` : undefined;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(site.photo), Astro.site);
const fullTitle = `${title} | ${site.name}`;
const summary = description ?? `${site.name}, ${site.jobTitle} at ${site.institution}.`;

const pages = await getCollection('pages');
const pageNav: NavItem[] = pages
  .filter((page) => page.data.showInNav as boolean)
  .map((page) => ({
    label: page.data.title as string,
    href: page.id === 'home' ? '/' : `/${page.id}`,
    order: page.data.order as number,
  }));

const nav = [...pageNav, ...COLLECTION_NAV].sort((a, b) => a.order - b.order);
const pathname = Astro.url.pathname;
const themeIds = THEMES.map((theme) => theme.id);
---
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#7b4b8a" />
    {(noindex || !isIndexable) && <meta name="robots" content="noindex" />}

    <!-- Link previews: this URL gets pasted into email and chat. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.labName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <Tokens />
    <!-- Applied before first paint so switching themes never flashes. -->
    <script is:inline define:vars={{ themeIds, fallback: DEFAULT_THEME }}>
      try {
        const stored = localStorage.getItem('demo-theme');
        document.documentElement.dataset.theme = themeIds.includes(stored) ? stored : fallback;
      } catch {
        document.documentElement.dataset.theme = fallback;
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <p class="demo-banner">
      <strong>Design preview</strong> — three candidate designs over real content,
      and the three they started from. People, news, projects, events and gallery
      entries are placeholders.
    </p>

    <div class="page">
      <nav class="site-nav nav" aria-label="Primary">
        {nav.map((item) => (
          <a href={url(item.href)} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <aside class="identity-column">
        <Identity primary={identityIsHeading} />
      </aside>

      <main id="main" class="flow prose">
        <slot />

        {/*
          The design that treats the site as something the lab built says where
          the page comes from and offers to open it. The others do not - one is
          a record and one is a feature, and neither wants its plumbing in the
          margin - so this is themed markup rather than a line every design has
          to find room for.
        */}
        {editHref && (
          <Themed themes="c">
            <p class="source-line">
              <span class="source-line__path">{source}</span>
              <a class="source-line__edit" href={editHref} rel="noopener">Edit this page on GitHub</a>
            </p>
          </Themed>
        )}
      </main>

      {/*
        A second column beside the content, for a page that wants one: an
        in-page index, a metadata rail. Rendered only when a page fills it, so
        it costs nothing on the pages that do not, and placed by each design
        from its own stylesheet.
      */}
      {Astro.slots.has('rail') && (
        <aside class="rail"><slot name="rail" /></aside>
      )}
    </div>

    <footer class="footer">
      <div class="footer__inner">
        <p>&copy; {new Date().getFullYear()} {site.labName}</p>
        <p>{site.name}</p>
        <p>{site.email}</p>
        <p>{site.jobTitle} | {site.department}</p>
        {site.office && <p>{site.office}</p>}
        {site.address && <p>{site.address}</p>}
        {/* The revision this build came from. Shown by the design that treats
            the site as an instrument; the others hide it. */}
        {revision && (
          <Themed themes="c">
            <p class="build-line">
              {/* The hash and the date are adjacent on one line: a newline
                  between two expressions becomes a space, which would put one
                  in front of the separator. */}
              rev <>{revisionHref ? <a href={revisionHref} rel="noopener">{revision.hash}</a> : revision.hash}</><span class="build-line__date"> · built from {revision.date}</span>
            </p>
          </Themed>
        )}
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
