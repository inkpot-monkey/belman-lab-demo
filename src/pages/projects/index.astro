---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoBanner from '../../components/DemoBanner.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order as number) - (b.data.order as number),
);
---
<BaseLayout title="Projects">
  <h1>Projects</h1>
  <DemoBanner what="Every project below is a placeholder, not a real description of the lab's work." />

  <ul class="cards">
    {projects.map((project) => (
      <li class="card">
        <h2 style="margin-block-start: 0;">{project.data.title}</h2>
        <p>{project.data.summary}</p>
        {project.data.funder && <p class="small muted">Funded by {project.data.funder}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
