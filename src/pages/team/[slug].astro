---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { displayEmail } from '../../lib/email.ts';
import { site } from '../../lib/site.ts';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);
const data = person.data as Record<string, unknown>;
// One site-wide choice: showing one person's address plainly while hiding
// another's would defeat the point of hiding either.
const email = data.email ? displayEmail(data.email as string, site.obfuscateEmail) : null;
---
<BaseLayout title={data.name as string} description={`${data.name}, ${data.rank} in the Belman Lab.`}>
  <h1>{data.name}</h1>
  <p class="muted">{data.rank}{data.pronouns ? ` · ${data.pronouns}` : ''}</p>

  {data.placeholder && (
    <p class="demo-note"><strong>Placeholder entry.</strong> This is not a real person.</p>
  )}

  <Content />

  <ul class="social" style="margin-block-start: var(--space-m);">
    {email && <li>{email.href ? <a href={email.href}>{email.text}</a> : email.text}</li>}
    {data.orcid && <li><a href={`https://orcid.org/${data.orcid}`} rel="noopener">ORCID</a></li>}
    {data.github && <li><a href={`https://github.com/${data.github}`} rel="noopener">GitHub</a></li>}
    {data.website && <li><a href={data.website as string} rel="noopener">Website</a></li>}
  </ul>
</BaseLayout>
